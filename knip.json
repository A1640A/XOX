{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "app/**/{page,layout,route,error,not-found,loading}.tsx",
        "app/**/route.ts",
        "middleware.ts",
        "next.config.ts"
      ],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": [
        "@node-rs/argon2",
        "@testing-library/user-event",
        "@vercel/analytics",
        "@vercel/speed-insights",
        "@xox/game-core",
        "@xox/shared",
        "@xox/ui-tokens",
        "jose",
        "mongodb",
        "next-auth",
        "zod"
      ]
    },
    "apps/mobile": {
      "entry": ["app/**/*.tsx", "app.config.ts"],
      "project": ["**/*.{ts,tsx}"],
      "ignoreDependencies": ["@xox/game-core", "@xox/shared", "expo-auth-session"]
    },
    "apps/e2e": {
      "entry": ["tests/**/*.spec.ts", "playwright.config.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["@xox/shared"]
    }
  },
  "ignoreDependencies": [
    "@vitest/coverage-v8",
    "lefthook",
    "vitest",
    "vite-tsconfig-paths",
    "@vitejs/plugin-react",
    "jsdom",
    "@testing-library/react",
    "@testing-library/jest-dom",
    "vercel"
  ],
  "ignore": ["**/*.d.ts", "vitest.shared.ts"]
}
